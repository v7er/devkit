{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devkit",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    {
      "pattern": "devkit.v7e.top",
      "custom_domain": true
    }
  ]
}
